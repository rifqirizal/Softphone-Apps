{
  "name": "com.synergix.webphone",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "test": "jest",
    "build:android:debug": "cd android && gradlew clean assembleDebug",
    "build:android:release": "cd android && gradlew clean assembleRelease",
    "build:android:bundle": "cd android && gradlew clean bundleRelease",
    "clean:android": "cd android && gradlew clean",
    "pod:install": "cd ios && pod install",
    "build:ios:debug": "react-native run-ios --configuration Debug",
    "build:ios:release": "react-native run-ios --configuration Release",
    "build:ios:archive": "cd ios && xcodebuild -workspace SynergixWebphone.xcworkspace -scheme SynergixWebphone -configuration Release -archivePath build/SynergixWebphone.xcarchive archive",
    "clean:ios": "cd ios && rm -rf build Pods Podfile.lock && pod install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "nativewind": "^4.2.7",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-incall-manager": "^4.3.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-webrtc": "^155.0.1",
    "sip.js": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "^5.0.0",
    "react-test-renderer": "18.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
